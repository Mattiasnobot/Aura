+}
+.result-card-evidence span.strong {
+  border-color: rgba(90, 214, 138, .3);
+  color: var(--ok);
+}
+.result-card-files {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--s2);
+  margin-top: var(--s3);
+}
+.result-file-chip {
+  max-width: 180px;
+  padding: 4px 8px;
+  overflow: hidden;
+  border: 1px solid rgba(var(--accent-rgb), .22);
+  border-radius: var(--r-pill);
+  color: var(--text-soft);
+  background: rgba(var(--accent-rgb), .055);
+  cursor: pointer;
+  font-size: var(--t-caption);
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.result-file-chip:hover {
+  border-color: rgba(var(--accent-rgb), .5);
+  color: var(--text);
+  background: rgba(var(--accent-rgb), .1);
+}
+.result-file-more {
+  align-self: center;
+  color: var(--text-dim);
+  font-size: var(--t-caption);
+}
+.result-card-details {
+  margin-top: var(--s3);
+  color: var(--text-dim);
+  font-size: var(--t-caption);
+}
+.result-card-details summary {
+  width: fit-content;
+  cursor: pointer;
+  color: var(--text-muted);
+}
+.result-card-details .message-task-tools {
+  margin-top: var(--s2);
+}
+.result-card-actions .primary {
+  border-color: rgba(var(--accent-rgb), .4);
+  color: var(--text);
+  background: rgba(var(--accent-rgb), .1);
+}
+.result-card-actions .danger {
+  margin-left: auto;
+  border-color: var(--danger-border);
+  color: var(--danger-soft);
+  background: transparent;
+}
+
+@media (max-width: 720px) {
+  .plan-strip.work-card {
+    margin-inline: 0;
+    padding: var(--s4);
+  }
+  .work-card-steps {
+    max-height: 150px;
+  }
+  .work-card-steps li {
+    grid-template-columns: 18px minmax(0, 1fr);
+  }
+  .work-card-steps li em {
+    display: none;
+  }
+  .message-task-card.result-card {
+    width: 100%;
+  }
+  .result-card-actions .danger {
+    margin-left: 0;
+  }
+}
