+
+
+/* Adaptive result cards: the same task card now changes its language based on
+ * what actually happened. Verification-only work is not presented as a build,
+ * and the backend's detailed evidence footer lives behind one disclosure
+ * instead of being repeated in the main conversation. */
+.message-task-card.result-card.verified {
+  border-left-color: rgba(127, 224, 209, .72);
+}
+.result-card.verified .result-card-mark {
+  border-color: rgba(127, 224, 209, .4);
+  color: var(--accent);
+  background: rgba(var(--accent-rgb), .09);
+}
+.result-card-status.verified {
+  border-color: rgba(var(--accent-rgb), .34);
+  color: var(--accent);
+  background: rgba(var(--accent-rgb), .065);
+}
+.result-card.stopped .result-card-mark {
+  border-color: rgba(255, 180, 84, .38);
+  color: var(--warn);
+  background: rgba(255, 180, 84, .08);
+}
+.result-card-status.stopped {
+  border-color: rgba(255, 180, 84, .3);
+  color: var(--warn);
+  background: rgba(255, 180, 84, .06);
+}
+.result-card-proof {
+  margin-top: var(--s4);
+  padding-top: var(--s3);
+  border-top: 1px solid rgba(29, 48, 72, .72);
+}
+.result-card-proof summary {
+  color: var(--text-soft);
+}
+.result-card-proof-list {
+  display: grid;
+  gap: var(--s2);
+  margin: var(--s3) 0 0;
+  padding-left: 18px;
+  color: var(--text-muted);
+  font-size: var(--t-caption);
+  line-height: 1.5;
+}
+.result-card-proof-list code {
+  padding: 1px 4px;
+  border: 1px solid var(--border-strong);
+  border-radius: 4px;
+  color: #a9eadf;
+  background: var(--surface-0);
+  font: 10px/1.4 "Cascadia Mono", Consolas, monospace;
+}
