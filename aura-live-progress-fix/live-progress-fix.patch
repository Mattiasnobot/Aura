+    @staticmethod
+    def _clean_plan_step(line: str) -> dict | None:
+        """Turn one approved-plan line into a human step the UI can track.
+
+        Small local models occasionally put a textual tool call inside the plan:
+        a useful sentence followed by ```tool_call, JSON arguments, and ```.
+        Treating each of those lines as work produced the 0/4 card Mat saw.
+        Syntax is discarded here; only a real human-readable action survives.
+        """
+        raw = str(line or "").strip()
+        if not raw:
+            return None
+        lowered = raw.casefold()
+        if (raw.startswith("```") or raw in {"{", "}", "[", "]"} or
+                lowered.startswith(("<tool_call", "</tool_call", "tool_call")) or
+                re.match(r'^\s*\{.*"(?:name|arguments)"\s*:', raw) or
+                re.match(r'^\s*"(?:name|arguments)"\s*:', raw)):
+            return None
+
+        # Bullets and ordered-list numbers are presentation, not part of the step.
+        text = re.sub(r"^\s*(?:[-*•]\s+|\d+[.)]\s+)", "", raw).strip()
+        if not text or text.startswith(("{", "}", "[", "]")):
+            return None
+
+        lower = text.casefold()
+        if re.search(r"\b(validate|validation|test|check accessibility|lint)\b", lower):
+            kind = "validate"
+        elif re.search(r"\b(read|inspect|review|look at|open|list|check)\b", lower):
+            kind = "read"
+        elif re.search(r"\b(research|search|look up|find online)\b", lower):
+            kind = "research"
+        elif re.search(r"\b(create|write|edit|update|change|modify|replace|add|build|remove|delete|move|copy)\b", lower):
+            kind = "write"
+        else:
+            # The approval dialog is primarily a file plan. A bare path such as
+            # `shop/index.html - main page` therefore means "produce this file".
+            kind = "write"
+
+        # Prefer a path in backticks, then a filename/folder-looking token.
+        quoted = re.search(r"`([^`\r\n]+)`", text)
+        candidate = quoted.group(1) if quoted else ""
+        if not candidate:
+            token = re.search(
+                r"(?<![\w.-])((?:[\w.-]+[/\\])+[\w.-]+(?:\.[A-Za-z0-9_-]+)?|"
+                r"[\w.-]+\.(?:py|json|toml|md|txt|html|css|js|ts|tsx|jsx|yaml|yml|svg|xml))"
+                r"(?![\w.-])",
+                text,
+            )
+            candidate = token.group(1) if token else ""
+        path = str(candidate).replace("\\", "/").strip(" ./`'\"(),:;")
+        return {"path": path, "text": text, "kind": kind, "done": False}
+
